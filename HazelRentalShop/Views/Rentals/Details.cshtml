@model HazelRentalShop.Models.Rental

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Rental</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Customer!.FirstName) @Html.DisplayFor(model => model.Customer!.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Movie)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie!.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RentDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RentDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ReturnDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ReturnDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsPaid)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsPaid)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

<!-- Collapsible Section for Rental Details -->
<button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#rentalDetailsCollapse" aria-expanded="false" aria-controls="rentalDetailsCollapse">
    View Rental Details
</button>

<div class="collapse mt-3" id="rentalDetailsCollapse">
    <div class="card card-body">
        <h5>Rental Details</h5>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Customer Information</th>
                    <th>Movie Information</th>
                    <th>Rental Information</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>ID:</strong> @Model!.Customer?.Id <br />
                        <strong>Name:</strong> @Model.Customer?.FirstName @Model.Customer?.LastName <br />
                        <strong>Date of Birth:</strong> @Model.Customer?.DateOfBirth <br />
                        <strong>Age:</strong> @Model.Customer?.Age <br />
                        <strong>Sex:</strong> @Model.Customer?.Sex <br />
                        <strong>Address:</strong> @Model.Customer?.Address <br />
                        <strong>Email:</strong> @Model.Customer?.Email <br />
                        <strong>Phone:</strong> @Model.Customer?.Phone
                    </td>
                    <td>
                        <strong>ID:</strong> @Model.Movie?.Id <br />
                        <strong>Title:</strong> @Model.Movie?.Title <br />
                        <strong>Release Date:</strong> @Model.Movie?.DateRelease.ToString("yyyy-MM-dd") <br />
                        <strong>Director:</strong> @Model.Movie?.Director <br />
                        <strong>Genre:</strong> @Model.Movie?.Genre <br />
                        <strong>Description:</strong> @Model.Movie?.Description <br />
                        <strong>Rating:</strong> @Model.Movie?.Rating <br />
                        <strong>Price:</strong> ₱@Model.Movie?.Price.ToString("N2") <br />
                        <strong>Availability:</strong> @(Model.Movie?.IsAvailable == true ? "Available" : "Not Available")
                    </td>
                    <td>
                        <strong>Rental Date:</strong> @Model.RentDate.ToString("yyyy-MM-dd") <br />
                        <strong>Return Date:</strong> @(Model.ReturnDate?.ToString("yyyy-MM-dd") ?? "Not Returned") <br />
                        <strong>Quantity:</strong> @Model.Quantity <br />
                        <strong>Payment Status:</strong>
                        <span class="badge @(Model.IsPaid ? "bg-success" : "bg-danger")">
                            @(Model.IsPaid ? "Paid" : "Pending")
                        </span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>