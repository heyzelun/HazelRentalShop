<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HazelRentalShop</title>

    <!-- Bootstrap & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <link rel="stylesheet" href="~/css/mycsstheme.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HazelRentalShop.styles.css" asp-append-version="true" />

    <style>
        /* Sidebar Styling */
        .sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #1e3a8a; /* Darker blue shade */
            padding-top: 20px;
            transition: width 0.3s ease-in-out;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

            .sidebar a {
                padding: 12px 20px;
                text-decoration: none;
                font-size: 18px;
                color: white;
                display: flex;
                align-items: center;
                gap: 12px;
                transition: background 0.3s ease;
            }

                .sidebar a:hover {
                    background-color: #3755c7; /* Lighter blue on hover */
                }

        .content {
            margin-left: 250px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

        /* Sidebar Collapse */
        .collapsed {
            width: 60px;
        }

            .collapsed a span {
                display: none;
            }

            .collapsed + .content {
                margin-left: 60px;
            }

        /* Toggle Button */
        .toggle-btn {
            background: none;
            border: none;
            color: white;
            font-size: 24px;
            padding: 15px 20px;
            text-align: left;
            width: 100%;
            cursor: pointer;
            transition: background 0.3s ease;
        }

            .toggle-btn:hover {
                background-color: #3755c7;
            }
    </style>
</head>
<body>

    
    <!-- Sidebar Navigation -->
    <div class="sidebar" id="sidebar">
        <!-- Toggle Button (Moved to Top) -->
        <button class="toggle-btn" id="toggle-btn">
            <i class="fa-solid fa-bars"></i> <span id="menu-text"></span>
        </button>

        <a href="@Url.Action("Index", "Home")">
            <i class="fa-solid fa-house"></i> <span>Home</span>
        </a>
        @if (User.Identity!.IsAuthenticated)
        {
            <a href="@Url.Action("Index", "Movies")">
                <i class="fa-solid fa-film"></i> <span>Movies</span>
            </a>
            <a href="@Url.Action("Index", "Customers")">
                <i class="fa-solid fa-users"></i> <span>Customers</span>
            </a>
            <a href="@Url.Action("Index", "Rentals")">
                <i class="fa-solid fa-receipt"></i> <span>Rentals</span>
            </a>
        }
        <a href="@Url.Action("Privacy", "Home")">
            <i class="fa-solid fa-shield"></i> <span>Privacy</span>
        </a>
    </div>

    <!-- Main Content -->
    <div class="content" id="content">
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-3">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted mt-4">
            <div class="container">
                &copy; 2025 - HazelRentalShop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById("toggle-btn").addEventListener("click", function () {
            document.getElementById("sidebar").classList.toggle("collapsed");
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
